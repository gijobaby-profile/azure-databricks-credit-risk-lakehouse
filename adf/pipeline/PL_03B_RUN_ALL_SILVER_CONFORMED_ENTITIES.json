{
	"name": "PL_03B_RUN_ALL_SILVER_CONFORMED_ENTITIES_Test",
	"properties": {
		"description": "Iterates over active Silver Conformance entities returned from Unity Catalog and invokes PL_03A for each entity with controlled parallelism.",
		"activities": [
			{
				"name": "FE_RUN_SILVER_CONFORMED_ENTITIES",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(pipeline().parameters.p_entities_json).entities",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "EXEC_PL03A_RUN_ONE_ENTITY",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "entity_name",
									"value": "@item().entity_name"
								},
								{
									"name": "is_scd2",
									"value": "@string(item().is_scd2)"
								}
							],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_03A_RUN_ONE_SILVER_CONFORMED_ENTITY_Test",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_business_dt": {
										"value": "@pipeline().parameters.p_business_dt",
										"type": "Expression"
									},
									"p_pipeline_run_id": {
										"value": "@pipeline().parameters.p_pipeline_run_id",
										"type": "Expression"
									},
									"p_catalog_name": {
										"value": "@pipeline().parameters.p_catalog_name",
										"type": "Expression"
									},
									"p_source_system": {
										"value": "@pipeline().parameters.p_source_system",
										"type": "Expression"
									},
									"p_entity_name": {
										"value": "@item().entity_name",
										"type": "Expression"
									},
									"p_is_scd2": {
										"value": "@string(equals(toLower(item().entity_name), 'customer_scd2'))",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_business_dt": {
				"type": "string"
			},
			"p_pipeline_run_id": {
				"type": "string"
			},
			"p_catalog_name": {
				"type": "string",
				"defaultValue": "credit_risk_dev"
			},
			"p_source_system": {
				"type": "string",
				"defaultValue": "home_credit"
			},
			"p_entities_json": {
				"type": "string"
			}
		},
		"annotations": [
			"credit-risk-lakehouse",
			"silver-conformance",
			"parallel-execution",
			"batch-child"
		]
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}