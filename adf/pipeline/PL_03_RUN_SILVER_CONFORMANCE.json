{
	"name": "PL_03_RUN_SILVER_CONFORMANCE",
	"properties": {
		"description": "Waits for silver_standardization readiness, initializes silver_conformed status rows, reads entity routing configuration from Unity Catalog, and invokes a child pipeline to process entities in parallel.",
		"activities": [
			{
				"name": "UNTIL_STANDARDIZATION_READY_OR_TIMEOUT",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [
					{
						"name": "business_dt",
						"value": "@pipeline().parameters.p_business_dt"
					},
					{
						"name": "source_layer",
						"value": "@pipeline().parameters.p_source_layer_name"
					},
					{
						"name": "max_wait_minutes",
						"value": "@string(pipeline().parameters.p_max_wait_minutes)"
					}
				],
				"typeProperties": {
					"expression": {
						"value": "@or(equals(variables('v_overall_status'), 'READY'), greaterOrEquals(int(variables('v_elapsed_minutes')), pipeline().parameters.p_max_wait_minutes))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "NB_CHECK_SILVER_STANDARDIZATION_STATUS",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 120,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/gijobaby.info@gmail.com/azure-databricks-credit-risk-lakehouse/notebooks/07_orchestration/NB_CHECK_LAYER_PROCESSING_STATUS",
								"baseParameters": {
									"p_business_dt": {
										"value": "@pipeline().parameters.p_business_dt",
										"type": "Expression"
									},
									"p_layer_name": {
										"value": "@pipeline().parameters.p_source_layer_name",
										"type": "Expression"
									},
									"p_catalog_name": {
										"value": "@pipeline().parameters.p_catalog_name",
										"type": "Expression"
									},
									"p_expected_frequency": {
										"value": "@pipeline().parameters.p_expected_frequency",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZDBRICKS_DEV",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SET_OVERALL_STATUS",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "NB_CHECK_SILVER_STANDARDIZATION_STATUS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_overall_status",
								"value": {
									"value": "@json(activity('NB_CHECK_SILVER_STANDARDIZATION_STATUS').output.runOutput).overall_status",
									"type": "Expression"
								}
							}
						},
						{
							"name": "IF_NOT_READY_WAIT_AND_INCREMENT",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "SET_OVERALL_STATUS",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(not(equals(variables('v_overall_status'), 'READY')), less(int(variables('v_elapsed_minutes')), pipeline().parameters.p_max_wait_minutes))",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "WAIT_BEFORE_NEXT_STATUS_CHECK",
										"type": "Wait",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"waitTimeInSeconds": {
												"value": "@mul(pipeline().parameters.p_poll_interval_minutes, 60)",
												"type": "Expression"
											}
										}
									},
									{
										"name": "SET_ELAPSED_MINUTES_TMP",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "WAIT_BEFORE_NEXT_STATUS_CHECK",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_elapsed_minutes_tmp",
											"value": {
												"value": "@string(add(int(variables('v_elapsed_minutes')), pipeline().parameters.p_poll_interval_minutes))",
												"type": "Expression"
											}
										}
									},
									{
										"name": "SET_ELAPSED_MINUTES",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "SET_ELAPSED_MINUTES_TMP",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "v_elapsed_minutes",
											"value": {
												"value": "@variables('v_elapsed_minutes_tmp')",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					],
					"timeout": "0.12:00:00"
				}
			},
			{
				"name": "IF_READY_RUN_SILVER_CONFORMED",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "UNTIL_STANDARDIZATION_READY_OR_TIMEOUT",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(variables('v_overall_status'), 'READY')",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "SET_FINAL_MESSAGE_TIMEOUT",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_final_message",
								"value": {
									"value": "@concat('Silver conformance skipped. silver_standardization was not READY within max wait time. business_dt=', pipeline().parameters.p_business_dt, ', last_status=', variables('v_overall_status'), ', waited_minutes=', variables('v_elapsed_minutes'))",
									"type": "Expression"
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "NB_INIT_SILVER_CONFORMED_LAYER_STATUS_AND_CONTROL",
							"type": "DatabricksNotebook",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 120,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/gijobaby.info@gmail.com/azure-databricks-credit-risk-lakehouse/notebooks/07_orchestration/NB_INIT_SILVER_CONFORMED_LAYER_STATUS_AND_CONTROL",
								"baseParameters": {
									"p_business_dt": {
										"value": "@pipeline().parameters.p_business_dt",
										"type": "Expression"
									},
									"p_pipeline_run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"p_catalog_name": {
										"value": "@pipeline().parameters.p_catalog_name",
										"type": "Expression"
									},
									"p_source_system": {
										"value": "@pipeline().parameters.p_source_system",
										"type": "Expression"
									},
									"p_force_reload": {
										"value": "@string(pipeline().parameters.p_force_reload)",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZDBRICKS_DEV",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "NB_GET_SILVER_CONFORMANCE_ENTITIES",
							"type": "DatabricksNotebook",
							"dependsOn": [
								{
									"activity": "NB_INIT_SILVER_CONFORMED_LAYER_STATUS_AND_CONTROL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 1,
								"retryIntervalInSeconds": 120,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"notebookPath": "/Users/gijobaby.info@gmail.com/azure-databricks-credit-risk-lakehouse/notebooks/07_orchestration/NB_GET_SILVER_CONFORMANCE_ENTITIES",
								"baseParameters": {
									"p_catalog_name": {
										"value": "@pipeline().parameters.p_catalog_name",
										"type": "Expression"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_AZDBRICKS_DEV",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "EXEC_PL03B_RUN_ALL_ENTITIES",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "NB_GET_SILVER_CONFORMANCE_ENTITIES",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_03B_RUN_ALL_SILVER_CONFORMED_ENTITIES",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_business_dt": {
										"value": "@pipeline().parameters.p_business_dt",
										"type": "Expression"
									},
									"p_pipeline_run_id": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"p_catalog_name": {
										"value": "@pipeline().parameters.p_catalog_name",
										"type": "Expression"
									},
									"p_source_system": {
										"value": "@pipeline().parameters.p_source_system",
										"type": "Expression"
									},
									"p_entities_json": {
										"value": "@activity('NB_GET_SILVER_CONFORMANCE_ENTITIES').output.runOutput",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "SET_FINAL_MESSAGE_READY",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "EXEC_PL03B_RUN_ALL_ENTITIES",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_final_message",
								"value": {
									"value": "@concat('Silver conformance completed for business_dt=', pipeline().parameters.p_business_dt, '. Entity count=', string(json(activity('NB_GET_SILVER_CONFORMANCE_ENTITIES').output.runOutput).entity_count))",
									"type": "Expression"
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_business_dt": {
				"type": "string"
			},
			"p_catalog_name": {
				"type": "string",
				"defaultValue": "credit_risk_dev"
			},
			"p_source_system": {
				"type": "string",
				"defaultValue": "home_credit"
			},
			"p_expected_frequency": {
				"type": "string",
				"defaultValue": "monthly"
			},
			"p_source_layer_name": {
				"type": "string",
				"defaultValue": "silver_standardization"
			},
			"p_target_layer_name": {
				"type": "string",
				"defaultValue": "silver_conformed"
			},
			"p_force_reload": {
				"type": "bool",
				"defaultValue": false
			},
			"p_max_wait_minutes": {
				"type": "int",
				"defaultValue": 120
			},
			"p_poll_interval_minutes": {
				"type": "int",
				"defaultValue": 5
			}
		},
		"variables": {
			"v_overall_status": {
				"type": "String",
				"defaultValue": "WAITING"
			},
			"v_elapsed_minutes": {
				"type": "String",
				"defaultValue": "0"
			},
			"v_elapsed_minutes_tmp": {
				"type": "String",
				"defaultValue": "0"
			},
			"v_final_message": {
				"type": "String"
			}
		},
		"annotations": [
			"credit-risk-lakehouse",
			"silver-conformance",
			"metadata-driven",
			"layer-orchestration"
		]
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}