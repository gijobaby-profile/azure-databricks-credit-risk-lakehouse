{
	"name": "DS_ADLS_SUCCESS_MARKER",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS_LANDING_DEV",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_marker_file_name": {
				"type": "string",
				"defaultValue": "_SUCCESS"
			},
			"p_source_system": {
				"type": "string"
			},
			"p_entity_name": {
				"type": "string"
			},
			"p_business_dt": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().p_marker_file_name",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().p_source_system, '/', dataset().p_entity_name, '/', dataset().p_business_dt)",
					"type": "Expression"
				},
				"fileSystem": "landing"
			}
		}
	}
}