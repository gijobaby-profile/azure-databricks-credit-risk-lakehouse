{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-creditrisk-dev-uks-001"
		},
		"LS_ADLS_CURATED_DEV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcrcurateddevuks001.dfs.core.windows.net/"
		},
		"LS_ADLS_GOLD_DEV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcrgolddevuks001.dfs.core.windows.net/"
		},
		"LS_ADLS_LANDING_DEV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stcrlandingdevuks001.dfs.core.windows.net/"
		},
		"LS_KEYVAULT_DEV_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-creditrisk-dev-uks-01.vault.azure.net/"
		},
		"LS_AZDBRICKS_DEV_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0511-180517-1zf1i1a8"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_CURATED_DEV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_CURATED_DEV_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_GOLD_DEV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_GOLD_DEV_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_LANDING_DEV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_LANDING_DEV_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_KEYVAULT_DEV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('LS_KEYVAULT_DEV_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_LANDING_BINARY')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_LANDING_DEV",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_file_name": {
						"type": "string"
					},
					"p_source_system": {
						"type": "string"
					},
					"p_entity_name": {
						"type": "string"
					},
					"p_business_dt": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(dataset().p_source_system, '/', dataset().p_entity_name, '/', dataset().p_business_dt)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_LANDING_DEV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_LANDING_CSV')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_LANDING_DEV",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_file_name": {
						"type": "string"
					},
					"p_source_system": {
						"type": "string"
					},
					"p_entity_name": {
						"type": "string"
					},
					"p_business_dt": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(dataset().p_source_system, '/', dataset().p_entity_name, '/', dataset().p_business_dt)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_LANDING_DEV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_LANDING_FOLDER')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_LANDING_DEV",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_source_system": {
						"type": "string"
					},
					"p_entity_name": {
						"type": "string"
					},
					"p_business_dt": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": {
							"value": "@concat(dataset().p_source_system, '/', dataset().p_entity_name, '/', dataset().p_business_dt)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_LANDING_DEV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_ADLS_SUCCESS_MARKER')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_LANDING_DEV",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_marker_file_name": {
						"type": "string",
						"defaultValue": "_SUCCESS"
					},
					"p_source_system": {
						"type": "string"
					},
					"p_entity_name": {
						"type": "string"
					},
					"p_business_dt": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_marker_file_name",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat(dataset().p_source_system, '/', dataset().p_entity_name, '/', dataset().p_business_dt)",
							"type": "Expression"
						},
						"fileSystem": "landing"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_LANDING_DEV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AZDBRICKS_DEV')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-7405616233234267.7.azuredatabricks.net",
					"accessToken": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "LS_KEYVAULT_DEV",
							"type": "LinkedServiceReference"
						},
						"secretName": "sec-dbx-adf-sp-token"
					},
					"existingClusterId": "[parameters('LS_AZDBRICKS_DEV_properties_typeProperties_existingClusterId')]"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_KEYVAULT_DEV')]"
			]
		}
	]
}